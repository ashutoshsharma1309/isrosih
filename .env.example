# =====================================================================
# VARUNA AI — environment configuration template.
# Copy to `.env` (repo root and/or backend/) and fill in real values.
# The `.env` file is git-ignored; NEVER commit credentials.
# =====================================================================

# --- Application ---
ENVIRONMENT=development

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=varuna
POSTGRES_PASSWORD=varuna
POSTGRES_DB=varuna_ai

# --- Frontend ---
# Base URL of the backend API (leave empty in dev; Vite proxies /api).
VITE_API_URL=

# --- Satellite data sources (Phase 2) ---
# MOSDAC (https://mosdac.gov.in) — registered account required.
MOSDAC_API_USER=
MOSDAC_API_PASSWORD=
# NASA Earthdata (https://urs.earthdata.nasa.gov) — bearer token.
NASA_EARTHDATA_TOKEN=
